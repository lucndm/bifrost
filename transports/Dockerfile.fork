# Fork-specific image: builds core, framework, and transports together via the
# Go workspace so the dashboard always matches the local framework code,
# instead of consuming released framework versions from the module proxy
# (which is what transports/Dockerfile does with GOWORK=off).

# --- UI Build Stage: Build the React + Vite frontend ---
FROM node:25-alpine3.23@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS ui-builder
WORKDIR /app

RUN apk upgrade --no-cache

COPY ui/package*.json ./
RUN npm ci

COPY ui/ ./
RUN npm run build-enterprise

# --- Go Build Stage: Compile the Go binary against the local workspace ---
FROM golang:1.27.0-alpine3.24@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS builder
WORKDIR /app

RUN apk upgrade --no-cache && \
  apk add --no-cache gcc musl-dev sqlite-dev binutils binutils-gold

ENV CGO_ENABLED=1 GOOS=linux

# Copy module metadata first so dependency downloads stay layer-cached.
# go.work is gitignored in this repo, so it is generated here instead of copied.
COPY core/go.mod core/go.sum ./core/
COPY framework/go.mod framework/go.sum ./framework/
COPY plugins/adaptive/go.mod plugins/adaptive/go.sum ./plugins/adaptive/
COPY plugins/guardrails/go.mod plugins/guardrails/go.sum ./plugins/guardrails/
COPY plugins/tokensaver/go.mod plugins/tokensaver/go.sum ./plugins/tokensaver/
COPY transports/go.mod transports/go.sum ./transports/

RUN printf 'go 1.27.0\n\nuse (\n\t./core\n\t./framework\n\t./plugins/guardrails\n\t./plugins/tokensaver\n\t./transports\n)\n\nreplace github.com/maximhq/bifrost/plugins/adaptive v0.1.0 => ./plugins/adaptive
replace github.com/maximhq/bifrost/plugins/guardrails v0.1.0 => ./plugins/guardrails\nreplace github.com/maximhq/bifrost/plugins/tokensaver v0.1.0 => ./plugins/tokensaver\n' > go.work

RUN cd core && go mod download && \
  cd ../framework && go mod download && \
  cd ../plugins/tokensaver && go mod download && \
  cd ../../transports && go mod edit -replace=github.com/maximhq/bifrost/plugins/adaptive@v0.1.0=../plugins/adaptive && \
  go mod edit -replace=github.com/maximhq/bifrost/plugins/tokensaver@v0.1.0=../plugins/tokensaver && \
  go mod download && \
  go work sync

# Copy full sources and build through the workspace
COPY core/ ./core/
COPY framework/ ./framework/
COPY plugins/adaptive/ ./plugins/adaptive/
COPY plugins/guardrails/ ./plugins/guardrails/
COPY plugins/tokensaver/ ./plugins/tokensaver/
COPY transports/ ./transports/

COPY --from=ui-builder /app/out ./transports/bifrost-http/ui

ARG VERSION=unknown
RUN cd transports && \
  go build \
  -ldflags="-w -s -X main.Version=v${VERSION} -extldflags '-static'" \
  -a -trimpath \
  -tags "sqlite_static" \
  -o /app/main \
  ./bifrost-http

RUN test -f /app/main || (echo "Build failed" && exit 1)

# --- Runtime Stage: Minimal runtime image ---
FROM alpine:3.23.5@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40
WORKDIR /app

RUN apk upgrade --no-cache && \
  apk add --no-cache musl libgcc ca-certificates zlib

COPY --from=builder /app/main .
COPY transports/docker-entrypoint.sh ./docker-entrypoint.sh

ARG ARG_APP_PORT=8080
ARG ARG_APP_HOST=0.0.0.0
ARG ARG_LOG_LEVEL=info
ARG ARG_LOG_STYLE=json
ARG ARG_APP_DIR=/app/data

ENV APP_PORT=$ARG_APP_PORT \
  APP_HOST=$ARG_APP_HOST \
  LOG_LEVEL=$ARG_LOG_LEVEL \
  LOG_STYLE=$ARG_LOG_STYLE \
  APP_DIR=$ARG_APP_DIR

ENV GOGC="" \
  GOMEMLIMIT=""

RUN mkdir -p "$APP_DIR/logs" && \
  adduser -D -s /bin/sh appuser && \
  chown -R appuser:appuser /app && \
  chown -R appuser:0 "$APP_DIR" && \
  { [ "$APP_DIR" = "/app" ] || chmod -R g=rwX "$APP_DIR"; } && \
  chmod +x /app/docker-entrypoint.sh

USER 1000:0

VOLUME ["${APP_DIR}"]
EXPOSE $APP_PORT

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:${APP_PORT}/health || exit 1

ENTRYPOINT ["/app/docker-entrypoint.sh"]
